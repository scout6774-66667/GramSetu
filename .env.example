# GramSetu AI Environment Configuration
APP_NAME="GramSetu AI"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
SNAPSHOT_PATH="./data/gramsetu_snapshot.json"
MAX_REQUEST_SIZE_BYTES=1048576
MAX_RECOVERY_CANDIDATES=8
SINGLE_WRITER_ENFORCED=true

# Authentication & Security
AUTH_MODE="auto"
JWT_SECRET_KEY="replace-with-secure-32-byte-hex-in-production"
JWT_ISSUER="gramsetu-auth"
JWT_AUDIENCE="gramsetu-api"

# PostgreSQL & PostGIS Database Configuration
# You can specify the full connection string:
DATABASE_URL="postgresql://gramsetu_user:replace_with_password@localhost:5432/gramsetu_db"

# Or configure individual connection parameters:
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="gramsetu_db"
POSTGRES_USER="gramsetu_user"
POSTGRES_PASSWORD=""
POSTGRES_SCHEMA="public"
POSTGIS_ENABLED=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
